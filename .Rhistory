x    = sqrt(r) * cos(th),
y    = sqrt(r) * sin(th)
)
}
# Generar todos los puntos para cada ciudad
set.seed(2021)
View(datos)
library(ggplot2)
library(ggforce)
library(dplyr)
library(tidyr)
# Dataframe de entrada con ciudades y cantidad de puntos
df_cities <- data.frame(
city = c("Ciudad A", "Ciudad B", "Ciudad C", "Ciudad D"),
n    = c(1000, 1000, 2000, 2000)
)
generate_circle_points <- function(n) {
r  <- runif(n)
th <- runif(n, 0, 2 * pi)
data.frame(
x = sqrt(r) * cos(th),
y = sqrt(r) * sin(th)
)
}
datos |>
rowwise() |>
mutate(points = list(generate_circle_points(pob))) |>
ungroup() |>
unnest(points) |>
select(-n)
datos |>
# rowwise() |>
mutate(points = list(generate_circle_points(pob))) |>
ungroup() |>
unnest(points)
df_cities <- datos |>
mutate(points = list(generate_circle_points(pob))) |>
unnest(points)
# Dataframe de círculos (uno por ciudad, centrado en el origen)
df_circles <- df_cities |>
select(city) |>
mutate(x0 = 0, y0 = 0, r = 1)
# Dataframe de círculos (uno por ciudad, centrado en el origen)
df_circles <- df_cities |>
select(nombre_comuna) |>
mutate(x0 = 0, y0 = 0, r = 1)
# Plot único con facet_wrap
ggplot() +
geom_circle(
data = df_circles,
aes(x0 = x0, y0 = y0, r = r)
) +
geom_point(
data = df_points,
aes(x = x, y = y)
) +
coord_fixed() +
theme_void() +
facet_wrap(~ city)
# Plot único con facet_wrap
ggplot() +
geom_circle(
data = df_circles,
aes(x0 = x0, y0 = y0, r = r)
) +
geom_point(
data = df_points,
aes(x = x, y = y)
) +
coord_fixed() +
theme_void() +
facet_wrap(~ nombre_comuna)
